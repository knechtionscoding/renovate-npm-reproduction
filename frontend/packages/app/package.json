  "scripts": {
    "build": "SKIP_PREFLIGHT_CHECK=true node scripts/build.js",
    "dev": "SKIP_PREFLIGHT_CHECK=true node scripts/start.js",
    "fix": "npm run prettier:fix && npm run lint:fix && npm run typecheck",
    "lint:errors": "eslint src --quiet",
    "lint:fix": "eslint src --cache --fix",
    "lint": "eslint src --cache",
    "prettier:check": "prettier --check '**/*.{js,jsx,ts,tsx,css,scss,json}'",
    "prettier:fix": "prettier --write '**/*.{js,jsx,ts,tsx,css,scss,json}'",
    "start": "npm install && npm run dev",
    "test": "SKIP_PREFLIGHT_CHECK=true node scripts/test.js",
    "typecheck": "tsc",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "echo -n \"\" > __snapshots__/usedSnapshots.txt && test-storybook --skipTags=\"flaky-test\"",
    "storybook:test:flaky": "test-storybook --includeTags=\"flaky-test\"",
    "storybook:snapshot-check": "node scripts/check-unused-snapshots.js",
    "schema:generate": "orval",
    "how-outdated": "python3 scripts/generate_outdated_packages_csv.py",
    "e2e:test": "playwright test",
    "e2e:test:ui": "playwright test --ui-host=0.0.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "globalSetup": "<rootDir>/config/jest/setup.js",
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.{js,jsx,ts,tsx}",
      "!<rootDir>/node_modules/",
      "!<rootDir>/**/__mocks__/**",
      "!<rootDir>/**/__puppet__/**",
      "!<rootDir>/**/__fixtures__/**",
      "!<rootDir>/**/__snapshots__/**",
      "!<rootDir>/**/__utils__/**",
      "!<rootDir>/src/app/App.tsx",
      "!<rootDir>/src/index.tsx",
      "!<rootDir>/src/contexts/**",
      "!<rootDir>/src/hooks/**",
      "!<rootDir>/src/layouts/**",
      "!<rootDir>/src/lib/constants/**",
      "!<rootDir>/src/lib/errors.ts",
      "!<rootDir>/src/polyfills/**",
      "!<rootDir>/src/react-app-env.d.ts",
      "!<rootDir>/src/**/*.stories.tsx",
      "!<rootDir>/src/lib/openApi/structured/schema.schemas.ts",
      "!<rootDir>/src/lib/openApi/structured/schema.ts",
      "!<rootDir>/src/lib/openApi/unstructured/schema.schemas.ts",
      "!<rootDir>/src/lib/openApi/unstructured/schema.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.tsx"
    ],
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "testEnvironment": "<rootDir>/jest-extended.ts",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "msw"
      ]
    },
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!([^/]+)/)",
      "<rootDir>/../../node_modules/(?!(monaco-editor)/)"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy",
      "^@/(.*)$": "<rootDir>/src/$1",
      "monaco-editor$": "<rootDir>/../../node_modules/monaco-editor/esm/vs/editor/editor.api.js"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true,
    "coverageReporters": [
      "text",
      "html",
      "cobertura"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 25,
        "lines": 25,
        "statements": 25
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "suiteName": "jest tests",
          "outputDirectory": "./__jest-results__/jest",
          "outputName": "junit.xml",
          "ancestorSeparator": "/"
        }
      ]
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "overrides": {
    "simple-react-calendar": {
      "react": "^18.0.0",
      "react-dom": "^18.0.0"
    }
  },
  "msw": {
    "workerDirectory": "public"
  }
}
